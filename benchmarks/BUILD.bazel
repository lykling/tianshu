# =============================================================================
# TIANSHU benchmarks Bazel build
# =============================================================================

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "version_benchmark",
    srcs = ["version_benchmark.cc"],
    deps = [
        "//tianshu",
        "@google_benchmark//:benchmark",
    ],
)

cc_binary(
    name = "object_pool_benchmark",
    srcs = ["object_pool_benchmark.cc"],
    deps = [
        "//tianshu",
        "@google_benchmark//:benchmark",
    ],
)

cc_binary(
    name = "lineage_benchmark",
    srcs = ["lineage_benchmark.cc"],
    deps = [
        "//tianshu",
        "@google_benchmark//:benchmark",
    ],
)

cc_binary(
    name = "codegen_vs_handwritten",
    srcs = ["codegen_vs_handwritten.cc"],
    data = ["//tianshu:headers"],
    deps = [
        "//tianshu",
        "//tianshu:tianshu_compiler",
        "@google_benchmark//:benchmark",
    ],
)

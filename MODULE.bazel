# =============================================================================
# TIANSHU Bazel Module (Bzlmod)
# =============================================================================
#
# Per ADR-0003, TIANSHU uses Bazel 7+ with Bzlmod for dependency management.
# The legacy WORKSPACE file is kept empty for backward compatibility.
#
# Reference: https://bazel.build/external/migration

module(
    name = "tianshu",
    version = "0.1.0",
)

# =============================================================================
# Phase 0: rules_cc required by Bazel 9+ for cc_library / cc_binary rules.
# =============================================================================
bazel_dep(name = "rules_cc", version = "0.0.17")

# GoogleTest (includes GoogleMock) — build-time only, per ALLOWED_DEPS.txt.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")


load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "ir_test",
    size = "small",
    srcs = ["ir_test.cc"],
    deps = [
        "//tianshu",
        "//tianshu:tianshu_compiler",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "pipeline_test",
    # Invokes the system compiler to build the generated artifact.
    size = "large",
    srcs = ["pipeline_test.cc"],
    data = ["//tianshu:headers"],
    deps = [
        "//tianshu",
        "//tianshu:tianshu_compiler",
        "@googletest//:gtest_main",
    ],
)

# =============================================================================
# TIANSHU library Bazel build
# =============================================================================

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "tianshu",
    srcs = [
        "src/component.cc",
        "src/data_dispatcher.cc",
        "src/data_notifier.cc",
        "src/dsl_runtime.cc",
        "src/field_table.cc",
        "src/hybrid_transport.cc",
        "src/intra_backend.cc",
        "src/launcher.cc",
        "src/lineage.cc",
        "src/monitor.cc",
        "src/node.cc",
        "src/record.cc",
        "src/record_v2.cc",
        "src/schema_sidecar.cc",
        "src/shm_backend.cc",
        "src/shm_segment.cc",
        "src/sla_analyzer.cc",
        "src/sla_stats.cc",
        "src/transport_backend.cc",
        "src/version.cc",
    ],
    hdrs = [
        "include/tianshu/base/atomic_hash_map.h",
        "include/tianshu/base/cache_buffer.h",
        "include/tianshu/base/object_pool.h",
        "include/tianshu/base/rw_lock.h",
        "include/tianshu/base/spin_lock.h",
        "include/tianshu/base/sync.h",
        "include/tianshu/core/component.h",
        "include/tianshu/core/data_dispatcher.h",
        "include/tianshu/core/data_notifier.h",
        "include/tianshu/core/data_visitor.h",
        "include/tianshu/core/field_table.h",
        "include/tianshu/core/launcher.h",
        "include/tianshu/core/lineage.h",
        "include/tianshu/core/message_concept.h",
        "include/tianshu/core/message_traits.h",
        "include/tianshu/core/monitor.h",
        "include/tianshu/core/node.h",
        "include/tianshu/core/typed_reader.h",
        "include/tianshu/core/typed_writer.h",
        "include/tianshu/dsl/dsl_runtime.h",
        "include/tianshu/dsl/flow.h",
        "include/tianshu/dsl/record.h",
        "include/tianshu/dsl/record_v2.h",
        "include/tianshu/sched/scheduler.h",
        "include/tianshu/shm/offset_ptr.h",
        "include/tianshu/shm/shm_ring.h",
        "include/tianshu/shm/shm_segment.h",
        "include/tianshu/sla/sla_analyzer.h",
        "include/tianshu/sla/sla_stats.h",
        "include/tianshu/transport/hybrid_transport.h",
        "include/tianshu/transport/intra_backend.h",
        "include/tianshu/transport/schema_sidecar.h",
        "include/tianshu/transport/shm_backend.h",
        "include/tianshu/transport/transport_backend.h",
        "include/tianshu/version.h",
    ],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror",
    ],
    defines = select({
        "//bazel/tianshu:profile_desktop": ["TIANSHU_PROFILE_DESKTOP"],
        "//bazel/tianshu:profile_server": ["TIANSHU_PROFILE_SERVER"],
        "//bazel/tianshu:profile_vehicle": ["TIANSHU_PROFILE_VEHICLE"],
        "//bazel/tianshu:profile_embedded": ["TIANSHU_PROFILE_EMBEDDED"],
        "//bazel/tianshu:profile_mcu": ["TIANSHU_PROFILE_MCU"],
        "//conditions:default": ["TIANSHU_PROFILE_DESKTOP"],
    }),
    include_prefix = "",
    linkopts = [
        "-llz4",
        "-lzstd",
        "-pthread",
    ],
    strip_include_prefix = "include",
)

# Compiler library (ADR-0030): IR, passes, codegen. Grows through M-B/C.
cc_library(
    name = "tianshu_compiler",
    srcs = ["src/ir.cc"],
    hdrs = ["include/tianshu/compiler/ir.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["//tianshu"],
)

# =============================================================================
# TIANSHU clangd configuration
# =============================================================================
#
# clangd reads this file to find:
#   - compile_commands.json (compilation database)
#   - compile flags overrides
#   - inlay hints / diagnostics options
#
# Keys verified against clangd 22 (--check reports no unknown keys).

CompileFlags:
  # Root compile_commands.json is a symlink CMake refreshes per preset
  # (CMakeLists.txt); a hardcoded per-build path would go stale on preset
  # switches like the llvm/21 -> llvm/22 toolchain drift.
  CompilationDatabase: .

  # Editing must not fail on warnings; CI enforces them instead.
  Remove:
    - -Werror
    - -Wall
    - -Wextra
    - -Wpedantic

Diagnostics:
  ClangTidy:
    FastCheckFilter: None
    # Mirror .clang-tidy: same families enabled, same documented exceptions.
    # clangd applies these on top of any Checks read from .clang-tidy.
    Remove: bugprone-easily-swappable-parameters,bugprone-narrowing-conversions
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Suppress: [plugin_check]

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: Yes

Hover:
  ShowAKA: Yes

Index:
  StandardLibrary: Yes
  Background: Build

Completion:
  AllScopes: Yes
